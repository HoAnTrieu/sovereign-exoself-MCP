{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "sovereign-exoself": {
      "type": "local",
      "command": [
        "/home/hat/AionUI/sovereign-exoself-mcp/.venv/bin/python",
        "-m",
        "sovereign_exoself_mcp"
      ],
      "cwd": "/home/hat/AionUI/sovereign-exoself-mcp",
      "environment": {
        "PYTHONUNBUFFERED": "1",
        "SOVEREIGN_PROVIDER_MODE": "openrouter"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
