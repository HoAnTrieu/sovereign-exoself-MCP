{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "sovereign-exoself": {
      "type": "local",
      "command": ["/absolute/path/.venv/bin/python", "-m", "sovereign_exoself_mcp"],
      "cwd": "/absolute/project/path",
      "environment": {"PYTHONUNBUFFERED": "1"},
      "enabled": true,
      "timeout": 30000
    }
  }
}
